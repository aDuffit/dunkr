{% extends 'base.html.twig' %}

{% block title %}player{% endblock %}

{% block body %}
    <div class="flex flex-col lg:flex-row gap-6 p-4">

        {# --- COLONNE GAUCHE (INFOS & BADGES) --- #}
        <div class="w-full lg:w-72 flex flex-col gap-4">

            {# Carte Identité #}
            <div class="card bg-base-100 shadow-xl border border-base-300">
                <figure class="px-6 pt-6">
                    {# Image ou Initiales #}
                    <div class="avatar placeholder">
                        <div class="bg-neutral text-neutral-content rounded-2xl w-24 uppercase">
                            <span class="text-3xl font-bold">{{ player.name|slice(0, 2) }}</span>
                        </div>
                    </div>
                </figure>

                <div class="card-body items-center text-center p-6">
                    <h2 class="card-title text-xl font-black leading-tight">{{ player.name }}</h2>
                    <div class="text-sm opacity-60 font-bold mb-2">{{ player.team.name }}</div>

                    {# Badge Position - Look "Label" #}
                    <div class="badge badge-primary badge-lg rounded-md italic font-black uppercase text-[10px] tracking-widest w-full py-4">
{#                        {{ player.position }}#}
                        position
                    </div>

                    <div class="divider my-2"></div>

                    {# Liste d'infos type "Scouting Report" #}
                    <div class="w-full space-y-3 text-left">
                        <div class="flex justify-between items-center">
                            <span class="text-[10px] uppercase font-bold opacity-50">Âge</span>
                            <span class="font-mono font-bold">
{#                                {{ player.age }}#}
                                age
                            </span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-[10px] uppercase font-bold opacity-50">Taille</span>
                            <span class="font-mono font-bold">
{#                                {{ player.height }} cm#}
                                height cm
                            </span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-[10px] uppercase font-bold opacity-50">Pays</span>
                            <span class="font-bold">
{#                                {{ player.country }}#}
                                pays
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-orange-500 text-white p-4 rounded-2xl flex items-center gap-4 shadow-lg border-b-4 border-orange-700">
                <div class="text-3xl animate-bounce">🏆</div>
                <div class="leading-none">
                    <p class="text-[10px] font-black italic uppercase opacity-80">
                        Meilleur profil : {{ best_category }}
                    </p>
                    <p class="text-sm font-black uppercase tracking-tighter">
                        TOP {{ top_percentage < 1 ? 1 : top_percentage }}% DU CHAMPIONNAT
                    </p>
                </div>
            </div>

            <div class="w-full space-y-4 mt-6">

                {# Section Points Forts #}
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-success leading-none">↗</span>
                        <span class="text-[10px] font-black uppercase opacity-50 tracking-widest">Points forts</span>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {% for label, value in centiles %}
                            {% if value >= 80 %}
                                <div class="badge badge-success bg-success/10 text-success border-success/20 text-[10px] font-bold py-3">
                                    ● {{ label|replace({'_c': ''})|upper }}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                {# Section Axes d'amélioration #}
                <div class="mt-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-error leading-none">↘</span>
                        <span class="text-[10px] font-black uppercase opacity-50 tracking-widest">À améliorer</span>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {% for label, value in centiles %}
                            {% if value < 30 %}
                                <div class="badge badge-error bg-error/10 text-error border-error/20 text-[10px] font-bold py-3">
                                    ● {{ label|replace({'_c': ''})|upper }}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# --- ZONE DROITE (GRAPHIQUE PRINCIPAL) --- #}
        <div class="flex-1">
            <div class="card bg-base-100 shadow-xl border border-base-300 h-full">

                {# Header du Graphique (Large) #}
                <div class="p-8 border-b border-base-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <h1 class="text-4xl font-black tracking-tighter uppercase italic leading-none">{{ player.name }}</h1>
                        <p class="text-sm font-bold opacity-40 mt-1 uppercase tracking-widest">Analyse des centiles par poste</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="text-right hidden md:block">
                            <p class="text-[10px] font-bold opacity-30 italic">DATASCOUT.FR</p>
                            <p class="text-[10px] font-bold opacity-20 uppercase">Saison 2025-26</p>
                        </div>
                        {# Petit bouton "Screenshot" ou Print #}
                        <button class="btn btn-circle btn-ghost btn-sm border border-base-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </button>
                    </div>
                </div>

                {# Conteneur du Graphique #}
                <div class="card-body p-2 md:p-10 flex items-center justify-center min-h-[550px]">
                    <div class="w-full h-full relative">
                        {{ render_chart(chart) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
