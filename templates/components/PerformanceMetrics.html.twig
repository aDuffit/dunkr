{# templates/components/PerformanceMetrics.html.twig #}
<div {{ attributes }} class="w-full space-y-4">
    {% for metric in this.metrics %}
        {% set val1 = attribute(player1, metric.key)|default(0) %}
        {% set val2 = player2 ? attribute(player2, metric.key)|default(0) : null %}

        <div class="bg-slate-800/50 border border-white/5 rounded-2xl p-4 transition-all hover:bg-slate-800">
            <div class="flex justify-between items-center mb-2">
                {# Valeur Joueur 1 #}
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-black italic {{ val2 and val1 > val2 ? 'text-green-400' : 'text-white' }}">
                        {{ val1|round(1) }}
                    </span>
                    <span class="text-[10px] text-slate-500 font-bold uppercase">/{{ metric.max }}</span>
                </div>

                {# Label #}
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 italic">
                    {{ metric.label }}
                </span>

                {# Valeur Joueur 2 (si présent) #}
                {% if val2 is not null %}
                    <div class="flex items-baseline gap-1">
                        <span class="text-xl font-black italic {{ val2 > val1 ? 'text-red-400' : 'text-slate-500' }}">
                            {{ val2|round(1) }}
                        </span>
                    </div>
                {% else %}
                    <div class="w-10"></div> {# Spacer pour l'équilibre #}
                {% endif %}
            </div>

            {# Barre de progression contextuelle #}
            <div class="relative h-2 w-full bg-slate-700 rounded-full overflow-hidden">
                {% if val2 is not null %}
                    {# MODE DUEL : Barre de Ratio bicolore #}
                    {% set total = val1 + val2 %}
                    {% set percent1 = total > 0 ? (val1 / total * 100) : 50 %}
                    <div class="absolute h-full bg-indigo-500 left-0 transition-all duration-700" style="width: {{ percent1 }}%"></div>
                    <div class="absolute h-full bg-red-500 right-0 transition-all duration-700" style="width: {{ 100 - percent1 }}%"></div>
                {% else %}
                    {# MODE SOLO : Barre de progression classique #}
                    {% set percentSolo = (val1 / metric.max * 100)|round %}
                    <div class="h-full bg-gradient-to-r from-indigo-600 to-indigo-400 rounded-full transition-all duration-1000" style="width: {{ percentSolo }}%"></div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>
