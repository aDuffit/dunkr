{# templates/components/StatsRadar.html.twig #}
<div {{ attributes }} class="w-full h-full flex flex-col items-center justify-center">
    <div class="w-full max-w-[300px]">
        {{ render_chart(this.chart) }}
    </div>

    {# Légende Custom #}
    <div class="flex gap-4 mt-4 text-[10px] font-black uppercase italic tracking-widest">
        <div class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
            <span class="text-slate-700">{{ player1.name }}</span>
        </div>
        {% if player2 %}
            <div class="flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                <span class="text-slate-700">{{ player2.name }}</span>
            </div>
        {% endif %}
    </div>
</div>
