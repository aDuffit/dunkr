{% set gradients = {
    'gold': 'from-yellow-100 via-yellow-400 to-yellow-600',
    'silver': 'from-slate-100 via-slate-300 to-slate-500',
    'bronze': 'from-orange-200 via-orange-400 to-orange-700'
} %}

<div {{ attributes }} class="relative group">
    <div class="relative bg-gradient-to-b {{ gradients[variant] }} p-1 rounded-[2rem] shadow-xl transition-transform group-hover:scale-105">
        <div class="bg-slate-900 rounded-[1.8rem] overflow-hidden relative">

            {# Note et Position #}
            <div class="flex p-4 items-start justify-between">
                <div class="text-center">
                    <div class="text-4xl font-black text-yellow-400 italic leading-none">
                        {{ this.overallRating }}
                    </div>
                    <div class="text-[10px] font-bold text-yellow-500 uppercase tracking-widest mt-1">
                        {{ player.position|default('N/A') }}
                    </div>
                </div>
            </div>

            {# Avatar #}
            <div class="relative h-40 flex justify-center items-end">
                <div class="w-32 h-32 bg-slate-800 rounded-full border-4 border-yellow-500 flex items-center justify-center text-5xl shadow-inner">
                    {{ player.name|slice(0, 1) }}
                </div>
            </div>

            {# Nom et Team #}
            <div class="text-center py-3 bg-yellow-500">
                <h2 class="text-xl font-black text-slate-900 uppercase italic tracking-tighter">{{ player.name }}</h2>
                <p class="text-[9px] font-bold text-slate-800 uppercase opacity-75">{{ player.team }}</p>
            </div>

            {# Stats rapides #}
            <div class="grid grid-cols-2 gap-2 p-4 text-yellow-100 border-t border-yellow-500/20 text-[11px]">
                <div class="flex justify-between border-b border-yellow-500/10 uppercase italic">
                    <span>PTS</span> <span class="font-black">{{ player.pointsAvg }}</span>
                </div>
                <div class="flex justify-between border-b border-yellow-500/10 uppercase italic">
                    <span>REB</span> <span class="font-black">{{ player.reboundsAvg }}</span>
                </div>
            </div>
        </div>
    </div>
</div>
