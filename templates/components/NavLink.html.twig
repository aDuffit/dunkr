<li {{ attributes }}>
    <a href="{{ url|default('#') }}" class="is-drawer-close:tooltip is-drawer-close:tooltip-right {{ active|default(false) ? 'text-orange-500' : 'text-slate-400' }}" data-tip="{{ label }}">
        <!-- Home icon -->
        <twig:ux:icon name="{{ icon }}" class="w-5 h-5 {{ active|default(false) ? 'text-orange-500' : 'text-slate-400' }}" />
        <span class="is-drawer-close:hidden"> {{ label }} </span>
    </a>
</li>
