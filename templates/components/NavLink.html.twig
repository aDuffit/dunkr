<li {{ attributes }}>
    <a href="{{ url|default('#') }}" class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="{{ label }}">
        <twig:ux:icon class="my-1.5 inline-block size-4" name="{{ icon }}" />
        <span class="is-drawer-close:hidden"> {{ label }} </span>
    </a>
</li>
