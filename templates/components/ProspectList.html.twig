<div{{ attributes }}>
    <input
        type="search"
        data-model="debounce(500)|query"
        placeholder="{{ 'form.placeholder_search_prospect'|trans }}"
        class="disabled:opacity-50"
        data-loading="addAttribute(disabled)"
    >
    <span class="loader" data-loading>🏀 Recherche...</span>

    <table data-loading="addAttribute(disabled)" class="w-full table-auto text-sm text-left disabled:opacity-50">
        <thead class="bg-gray-50 text-gray-600 font-medium border-b">
            <tr>
                <th class="py-3 px-6 text-center cursor-pointer hover:text-indigo-600"
                    data-action="click->live#action"
                    data-live-action-param="changeSort"
                    data-live-field-param="name">
                    <div class="flex items-center justify-center gap-1 group-hover:text-indigo-600">
                        {{ 'prospect.list.name'|trans|capitalize }}
                        {# Flèche Haut #}
                        <span class="leading-none {{ sortField == 'name' and sortDirection == 'ASC' ? 'text-indigo-600' : 'text-gray-300' }}" style="font-size: 0.6rem;">▲</span>
                        {# Flèche Bas #}
                        <span class="leading-none {{ sortField == 'name' and sortDirection == 'DESC' ? 'text-indigo-600' : 'text-gray-300' }}" style="font-size: 0.6rem;">▼</span>
                    </div>
                </th>
                <th class="py-3 px-6 text-center cursor-pointer hover:text-indigo-600"
                    data-action="click->live#action"
                    data-live-action-param="changeSort"
                    data-live-field-param="pointsAvg">
                    <div class="flex items-center justify-center gap-1 group-hover:text-indigo-600">
                        {{ 'prospect.list.points-avg'|trans|capitalize }}
                        {# Flèche Haut #}
                        <span class="leading-none {{ sortField == 'pointsAvg' and sortDirection == 'ASC' ? 'text-indigo-600' : 'text-gray-300' }}" style="font-size: 0.6rem;">▲</span>
                        {# Flèche Bas #}
                        <span class="leading-none {{ sortField == 'pointsAvg' and sortDirection == 'DESC' ? 'text-indigo-600' : 'text-gray-300' }}" style="font-size: 0.6rem;">▼</span>
                    </div>
                </th>
                <th class="py-3 px-6 text-center cursor-pointer hover:text-indigo-600"
                    data-action="click->live#action"
                    data-live-action-param="changeSort"
                    data-live-field-param="reboundsAvg">
                    <div class="flex items-center justify-center gap-1 group-hover:text-indigo-600">
                        {{ 'prospect.list.rebounds-avg'|trans|capitalize }}
                        {# Flèche Haut #}
                        <span class="leading-none {{ sortField == 'reboundsAvg' and sortDirection == 'ASC' ? 'text-indigo-600' : 'text-gray-300' }}" style="font-size: 0.6rem;">▲</span>
                        {# Flèche Bas #}
                        <span class="leading-none {{ sortField == 'reboundsAvg' and sortDirection == 'DESC' ? 'text-indigo-600' : 'text-gray-300' }}" style="font-size: 0.6rem;">▼</span>
                    </div>
                </th>
                <th class="py-3 px-6 text-center cursor-pointer hover:text-indigo-600"
                    data-action="click->live#action"
                    data-live-action-param="changeSort"
                    data-live-field-param="assistsAvg">
                    <div class="flex items-center justify-center gap-1 group-hover:text-indigo-600">
                        {{ 'prospect.list.assists-avg'|trans|capitalize }}
                        {# Flèche Haut #}
                        <span class="leading-none {{ sortField == 'assistsAvg' and sortDirection == 'ASC' ? 'text-indigo-600' : 'text-gray-300' }}" style="font-size: 0.6rem;">▲</span>
                        {# Flèche Bas #}
                        <span class="leading-none {{ sortField == 'assistsAvg' and sortDirection == 'DESC' ? 'text-indigo-600' : 'text-gray-300' }}" style="font-size: 0.6rem;">▼</span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody class="text-gray-600 divide-y">
            {% for prospect in this.prospects %}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <a href="{{ path('app_prospect_show', { 'id': prospect.id }) }}">{{ prospect.name }}</a>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ prospect.pointsAvg }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ prospect.reboundsAvg }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ prospect.assistsAvg }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4">{{ 'prospect.list.no-result'|trans|capitalize }}</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% if this.totalPages > 1 %}
        <div class="mt-4 px-6 py-4 border-t flex items-center justify-between bg-gray-50 rounded-b-lg">
            <div class="text-sm text-gray-600">
                Page <strong>{{ page }}</strong> sur <strong>{{ this.totalPages }}</strong>
            </div>

            <div class="flex items-center gap-2">
                {# Bouton Précédent #}
                <button
                        data-action="live#update"
                        data-live-action-param="debounce(0)|scroll(top)"
                        data-model="page"
                        data-value="{{ page - 1 }}"
                        {{ page <= 1 ? 'disabled' : '' }}
                        class="px-3 py-1 border rounded bg-white hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                >
                    Précédent
                </button>

                {# Bouton Suivant #}
                <button
                        data-action="live#update"
                        data-live-action-param="debounce(0)|scroll(top)"
                        data-model="page"
                        data-value="{{ page + 1 }}"
                        {{ page >= this.totalPages ? 'disabled' : '' }}
                        class="px-3 py-1 border rounded bg-white hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                >
                    Suivant
                </button>
            </div>
        </div>
    {% endif %}


    <div class="overflow-x-auto p-4 bg-slate-900 rounded-xl"> {# Fond sombre pour faire ressortir les cartes #}
        <table class="w-full border-separate border-spacing-y-3">
            <thead>
            <tr class="text-slate-400 text-xs uppercase tracking-widest">
                <th class="px-6 py-2 font-medium text-left">Prospect</th>
                <th class="px-6 py-2 font-medium text-center">PTS</th>
                <th class="px-6 py-2 font-medium text-center">REB</th>
                <th class="px-6 py-2 font-medium text-center">AST</th>
                <th class="px-6 py-2 font-medium text-right">Rating</th>
            </tr>
            </thead>
            <tbody data-loading="style(opacity: 0.5)">
            {% for prospect in this.prospects %}
                <tr class="bg-white hover:scale-[1.01] transition-transform cursor-pointer shadow-sm group">
                    {# Colonne Nom + Avatar #}
                    <td class="px-6 py-4 rounded-l-2xl border-y border-l border-gray-100">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center font-bold border-2 border-indigo-200">
                                {{ prospect.name|slice(0, 1) }}
                            </div>
                            <div>
                                <div class="font-black text-slate-800 uppercase italic">{{ prospect.name }}</div>
                                <div class="text-xs text-slate-400 font-bold uppercase">{{ prospect.team }}</div>
                            </div>
                        </div>
                    </td>

                    {# Stats avec codes couleurs FIFA #}
                    <td class="px-6 py-4 text-center border-y border-gray-100">
                        <span class="inline-block w-10 py-1 rounded font-bold {{ prospect.pointsAvg > 20 ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-600' }}">
                            {{ prospect.pointsAvg|round(1) }}
                        </span>
                    </td>

                    <td class="px-6 py-4 text-center border-y border-gray-100 font-bold text-slate-700">
                        {{ prospect.reboundsAvg|round(1) }}
                    </td>

                    <td class="px-6 py-4 text-center border-y border-gray-100 font-bold text-slate-700">
                        {{ prospect.assistsAvg|round(1) }}
                    </td>

                    {# Note Globale stylisée #}
                    <td class="px-6 py-4 text-right rounded-r-2xl border-y border-r border-gray-100">
                        <span class="text-xl font-black text-indigo-600 italic">
                            {{ (prospect.pointsAvg + prospect.reboundsAvg + prospect.assistsAvg) | round }}
                        </span>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
