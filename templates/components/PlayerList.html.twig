<div {{ attributes }} class="p-4">
    {# --- Recherche --- #}
    <div>
        <label class="input">
            <twig:ux:icon name="lucide:user-search" />
            <input
                type="search"
                data-model="debounce(500)|query"
                placeholder="{{ 'form.placeholder_search_player'|trans }}"
                class="grow"
                data-loading="addAttribute(disabled)"
            >
            <span data-loading="show" class="loading loading-spinner loading-md"></span>
        </label>
    </div>

    <div class="overflow-x-auto mt-2">
        <table class="table table-zebra">
            <thead>
            <tr>
                <th class="font-bold">{{ 'list.name'|trans({}, 'player') }}</th>
                <th>{{ 'list.position'|trans({}, 'player') }}</th>
                <th class="text-center cursor-pointer"
                    data-action="click->live#action"
                    data-live-action-param="changeSort"
                    data-live-field-param="points">
                    <div class="flex items-center justify-center gap-2">
                        {{ 'list.points'|trans({}, 'player') }}
                        <span class="text-[9px]">{{ sortField == 'points' ? (sortDirection == 'DESC' ? '▼' : '▲') : '⇅' }}</span>
                    </div>
                </th>
                <th class="text-center cursor-pointer"
                    data-action="click->live#action"
                    data-live-action-param="changeSort"
                    data-live-field-param="offensiveRebounds">
                    <div class="flex items-center justify-center gap-2">
                        {{ 'list.offensive_rebounds'|trans({}, 'player') }}
                        <span class="text-[9px]">{{ sortField == 'offensiveRebounds' ? (sortDirection == 'DESC' ? '▼' : '▲') : '⇅' }}</span>
                    </div>
                </th>
                <th class="text-center cursor-pointer"
                    data-action="click->live#action"
                    data-live-action-param="changeSort"
                    data-live-field-param="assists">
                    <div class="flex items-center justify-center gap-2">
                        {{ 'list.assists'|trans({}, 'player') }}
                        <span class="text-[9px]">{{ sortField == 'assists' ? (sortDirection == 'DESC' ? '▼' : '▲') : '⇅' }}</span>
                    </div>
                </th>
                <th>{{ 'list.progression'|trans({}, 'player') }}</th>
                <th>{{ 'list.action'|trans({}, 'player') }}</th>
            </tr>
            </thead>

            <tbody data-loading="addClass(opacity-50)">
            {% for player in this.players %}
                <tr class="hover">
                    <td>
                        <div class="flex items-center gap-3">
                            <div class="avatar avatar-placeholder">
                                <div class="bg-neutral text-neutral-content w-12 rounded-full">
                                    <span class="text-3xl">{{ player.name|first|capitalize }}</span>
                                </div>
                            </div>
                            <div>
                                <div class="font-bold">{{ player.name }}</div>
                                <div class="text-xs opacity-50">{{ player.team.name }}</div>
                            </div>
                        </div>
                    </td>

                    <td>
                        <div class="badge badge-outline badge-sm">Position todo</div>
                    </td>

                    <td class="text-center font-mono font-bold">{{ player.points }}</td>
                    <td class="text-center font-mono">{{ player.offensiveRebounds }}</td>
                    <td class="text-center font-mono">{{ player.assists }}</td>

                    <td>
                        <div class="flex items-center gap-2">
                            <progress class="progress progress-primary w-24" value="80" max="100"></progress>
                            <span class="text-xs">80%</span>
                        </div>
                    </td>

                    <th>
                        <a class="btn btn-ghost btn-xs" href="{{ path('app_player_show', {id: player.id}) }}">{{ 'btn.show'|trans }}</a>
                    </th>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center py-20 bg-slate-900/10">
                        {{ 'list.no_results'|trans({}, 'player') }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if this.totalPages > 1 %}
        <div class="flex justify-center mt-2">
            <div class="join">
                <button
                        data-action="live#update" data-model="debounce(0)|page" data-value="{{ page - 1 }}"
                        {{ page <= 1 ? 'disabled' : '' }}
                        class="join-item btn"><twig:ux:icon name="lucide:arrow-left" /></button>

                <twig:Button class="join-item btn"> {{ page }} </twig:Button>

                <button
                        data-action="live#update" data-model="debounce(0)|page" data-value="{{ page + 1 }}"
                        {{ page >= this.totalPages ? 'disabled' : '' }}
                        class="join-item btn">
                    <twig:ux:icon name="lucide:arrow-right" />
                </button>
            </div>
        </div>
    {% endif %}
</div>