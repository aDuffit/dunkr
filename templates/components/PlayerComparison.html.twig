<div {{ attributes }} class="bg-base-200 min-h-screen p-8">


    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'updateView',
            'class': 'flex flex-col md:flex-row items-center justify-center gap-6 mb-6',
        }
    }) }}
        <div class="w-full max-w-xs player1-select">
            <label class="label text-primary font-bold">Joueur 1</label>
            {{ form_row(form.player1, { 'label': false, 'attr': { 'data-loading': 'addClass(opacity-50) addAttribute(disabled)' }}) }}
        </div>

        <div class="text-2xl font-black italic opacity-20 uppercase pb-6">VS</div>

        <div class="w-full max-w-xs player2-select">
            <label class="label text-success font-bold">Joueur 2</label>
            {{ form_row(form.player2, { 'label': false, 'attr': { 'data-loading': 'addClass(opacity-50) addAttribute(disabled)' }}) }}
        </div>
    {{ form_end(form) }}

    <div class="bg-base-100 shadow-xl p-6 max-w-4xl mx-auto">
        <div data-loading="addClass(opacity-50)">
            {{ render_chart(this.chart) }}
        </div>
    </div>

    {% set p1 = form.player1.vars.data %}
    {% set p2 = form.player2.vars.data %}

    {% if p1 or p2 %}
        <div class="mt-12 max-w-4xl mx-auto overflow-x-auto">
            <table class="table table-zebra bg-base-100 shadow-xl rounded-xl overflow-hidden">
                <thead>
                <tr class="bg-base-300 text-base-content uppercase text-xs tracking-widest">
                    <th class="w-1/3">Statistique (par match)</th>
                    <th class="text-center text-primary w-1/3">{{ p1 ? p1.name : '-' }}</th>
                    <th class="text-center text-success w-1/3">{{ p2 ? p2.name : '-' }}</th>
                </tr>
                </thead>
                <tbody class="font-mono text-sm">
                {# Ligne Points #}
                <tr>
                    <td class="font-bold opacity-70 uppercase text-[10px]">Points</td>
                    <td class="text-center">{{ p1 ? (p1.points / p1.games)|number_format(1) : '-' }}</td>
                    <td class="text-center">{{ p2 ? (p2.points / p2.games)|number_format(1) : '-' }}</td>
                </tr>
                {# Ligne Rebonds #}
                <tr>
                    <td class="font-bold opacity-70 uppercase text-[10px]">Rebonds</td>
                    <td class="text-center">{{ p1 ? ((p1.offensiveRebounds + p1.defensiveRebounds) / p1.games)|number_format(1) : '-' }}</td>
                    <td class="text-center">{{ p2 ? ((p2.offensiveRebounds + p2.defensiveRebounds) / p2.games)|number_format(1) : '-' }}</td>
                </tr>
                {# Ligne Assists #}
                <tr>
                    <td class="font-bold opacity-70 uppercase text-[10px]">Assists</td>
                    <td class="text-center">{{ p1 ? (p1.assists / p1.games)|number_format(1) : '-' }}</td>
                    <td class="text-center">{{ p2 ? (p2.assists / p2.games)|number_format(1) : '-' }}</td>
                </tr>
                {# Ligne FG% #}
                <tr>
                    <td class="font-bold opacity-70 uppercase text-[10px]">FG %</td>
                    <td class="text-center">{{ p1 ? (p1.fieldsGoals / p1.fieldsGoalsAttempts * 100)|number_format(1) ~ '%' : '-' }}</td>
                    <td class="text-center">{{ p2 ? (p2.fieldsGoals / p2.fieldsGoalsAttempts * 100)|number_format(1) ~ '%' : '-' }}</td>
                </tr>
                {# Ligne FG% #}
                <tr>
                    <td class="font-bold opacity-70 uppercase text-[10px]">Steals %</td>
                    <td class="text-center">{{ p1 ? (p1.steals / p1.games)|number_format(1) : '-' }}</td>
                    <td class="text-center">{{ p2 ? (p2.steals / p2.games)|number_format(1) : '-' }}</td>
                </tr>
                </tbody>
            </table>
        </div>
    {% endif %}
</div>