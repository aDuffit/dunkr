<div {{ attributes }}>
    <div class="grid grid-cols-2 gap-4">
        <div class="card bg-base-100 col-span-2">
            <div class="card-body">
                <h2 class="card-title">Choix</h2>
                {{ form_start(form, {
                    attr: {
                        'data-action': 'live#$render',
                        'data-live-action-param': 'updateView',
                        'class': 'flex flex-col md:flex-row items-center justify-center gap-6 mb-6',
                    }
                }) }}

                <div class="w-full max-w-xs player1-select" data-loading="addClass(opacity-50) addAttribute(disabled)">
                    <label class="label font-bold" style="color: #3b82f6">{{ 'player_1'|trans({}, 'player') }}</label>
                    {{ form_row(form.player1, { 'label': false, 'attr': {
                        'class': 'border-primary',
                        'placeholder': 'form.placeholder_search_player'|trans(),
                    }}) }}
                </div>

                {% if form.player2 is defined %}
                    <div class="text-2xl font-black italic opacity-20 uppercase pb-6">VS</div>

                    <div class="w-full max-w-xs player2-select" data-loading="addClass(opacity-50) addAttribute(disabled)">
                        <label class="label font-bold" style="color: #22c55e">{{ 'player_2'|trans({}, 'player') }}</label>
                        {{ form_row(form.player2, { 'label': false, 'attr': {
                            'class': 'border-success',
                            'placeholder': 'form.placeholder_search_player'|trans(),
                        }}) }}
                    </div>
                {% endif %}
                {{ form_end(form) }}
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title">Card Title</h2>
                <p>A card component has a figure, a body part, and inside body there are title and actions parts</p>
            </div>
            <figure>
                {{ render_chart(this.chart) }}
            </figure>
        </div>



        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                {% set p1 = form.player1.vars.data %}
                {% if form.player2 is defined %}
                    {% set p2 = form.player2.vars.data %}
                {% else %}
                    {% set p2 = null %}
                {% endif %}

                <table class="table table-zebra">
                    <thead>
                    <tr>
                        <th>Statistique (par match)</th>
                        <th>{{ p1 ? p1.name : '-' }}</th>
                        <th>{{ p2 ? p2.name : '-' }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {# Ligne Points #}
                    <tr>
                        <td>Points</td>
                        <td>{{ p1 ? (p1.points / p1.games)|number_format(1) : '-' }}</td>
                        <td>{{ p2 ? (p2.points / p2.games)|number_format(1) : '-' }}</td>
                    </tr>
                    {# Ligne Rebonds #}
                    <tr>
                        <td>Rebonds</td>
                        <td>{{ p1 ? ((p1.offensiveRebounds + p1.defensiveRebounds) / p1.games)|number_format(1) : '-' }}</td>
                        <td>{{ p2 ? ((p2.offensiveRebounds + p2.defensiveRebounds) / p2.games)|number_format(1) : '-' }}</td>
                    </tr>
                    {# Ligne Assists #}
                    <tr>
                        <td>Assists</td>
                        <td>{{ p1 ? (p1.assists / p1.games)|number_format(1) : '-' }}</td>
                        <td>{{ p2 ? (p2.assists / p2.games)|number_format(1) : '-' }}</td>
                    </tr>
                    {# Ligne FG% #}
                    <tr>
                        <td>FG %</td>
                        <td>{{ p1 ? (p1.fieldsGoals / p1.fieldsGoalsAttempts * 100)|number_format(1) ~ '%' : '-' }}</td>
                        <td>{{ p2 ? (p2.fieldsGoals / p2.fieldsGoalsAttempts * 100)|number_format(1) ~ '%' : '-' }}</td>
                    </tr>
                    {# Ligne FG% #}
                    <tr>
                        <td>Steals %</td>
                        <td>{{ p1 ? (p1.steals / p1.games)|number_format(1) : '-' }}</td>
                        <td>{{ p2 ? (p2.steals / p2.games)|number_format(1) : '-' }}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>