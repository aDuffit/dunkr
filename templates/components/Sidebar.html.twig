<div {{ attributes }} class="drawer-side is-drawer-close:overflow-visible">
    <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
    <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-14 is-drawer-open:w-64">
        <!-- Sidebar content here -->
        <ul class="menu w-full grow">
            {% set routeName = app.request.attributes.get('_route') %}
            <twig:NavLink url="{{ path('app_player_index') }}" icon="lucide:users" label="{{ 'nav.player'|trans|capitalize }}" active="{{ 'app_player_index' == routeName }}" />
            <twig:NavLink url="{{ path('app_player_compare') }}" icon="lucide:arrow-left-right" label="{{ 'nav.compare'|trans|capitalize }}" />
            <twig:NavLink url="/settings" icon="lucide:settings" label="Settings" />
        </ul>
    </div>
</div>
