<div {{ attributes }}>
    <div class="card bg-base-100 card-md shadow-sm">
        <div class="card-body m-auto">
            <div class="avatar avatar-placeholder m-auto">
                <div class="bg-neutral text-neutral-content w-24 rounded-full m-auto">
                    <span class="text-3xl">{{ player.name|first|capitalize }}</span>
                </div>
            </div>

            <p class="text-center"> {{ player.name }} </p>

            {% if player.team %}
                <p class="text-center">
                    <twig:ux:icon name="lucide:map-pin" class="inline" /> {{ player.team.name }}
                </p>
            {% endif %}

            {% if player.position %}
                <div class="badge badge-outline badge-primary inline m-auto">
                    {% for position in player.position %}
                        {{ position|trans }} {% if loop.last == false %} / {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <ul class="list bg-base-100 rounded-box shadow-md mt-2">
        {% if null != player.age %}
            <li class="list-row">
                <div><twig:ux:icon name="lucide:calendar" class="size-10" /></div>
                <div>
                    <div>{{ 'detail.birthdate'|trans({}, 'player') }}</div>
                    <div class="text-xs uppercase font-semibold opacity-60">{{ player.age }} ans</div>
                </div>
            </li>
        {% endif %}

        {% if null != player.height %}
            <li class="list-row">
                <div><twig:ux:icon name="lucide:arrow-up-narrow-wide" class="size-10" /></div>
                <div>
                    <div>{{ 'detail.height'|trans({}, 'player') }}</div>
                    <div class="text-xs uppercase font-semibold opacity-60">{{ player.height }} kg</div>
                </div>
            </li>
        {% endif %}

        {% if player.weight > 0 %}
            <li class="list-row">
                <div><twig:ux:icon name="lucide:weight" class="size-10" /></div>
                <div>
                    <div>{{ 'detail.weight'|trans({}, 'player') }}</div>
                    <div class="text-xs uppercase font-semibold opacity-60">{{ player.weight }} cm</div>
                </div>
            </li>
        {% endif %}
    </ul>

    <div class="card bg-base-100 card-md shadow-sm mt-2">
        <div class="card-body m-auto">
            <twig:PlayerSummary :player="player" />
        </div>
    </div>

    <twig:PlayerFeature loading="lazy" :player="player" class="mt-2" />
</div>
