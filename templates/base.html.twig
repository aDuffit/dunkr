<!DOCTYPE html>
<html lang="fr" data-theme="cupcake">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>
        <div class="drawer lg:drawer-open">
            <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
            <div class="drawer-content">
                <div class="navbar bg-base-100 shadow-sm">
                    <div class="flex-1">
                        <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
                            <twig:ux:icon name="lucide:sidebar-open" class="my-1.5 inline-block size-4" />
                        </label>
                        <a class="btn btn-ghost text-xl">{{ 'site_name'|trans|upper }}</a>
                    </div>
                    <div class="flex-none">
                        <label class="toggle text-base-content">
                            <input type="checkbox" value="synthwave" class="theme-controller" />

                            <twig:ux:icon aria-label="sun" name="lucide:sun" class="h-5" />
                            <twig:ux:icon aria-label="moon" name="lucide:moon" class="h-5" />
                        </label>
                    </div>
                </div>

                <main class="p-4 bg-base-300">
                    {% block body %}{% endblock %}
                </main>
            </div>

            <div class="drawer-side is-drawer-close:overflow-visible">
                <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
                <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-14 is-drawer-open:w-64">
                    <ul class="menu w-full grow">
                        <twig:NavLink url="{{ path('app_player_index') }}" icon="lucide:user-search" label="{{ 'nav.player'|trans|capitalize }}" />
                        <twig:NavLink url="{{ path('app_player_compare') }}" icon="lucide:arrow-left-right" label="{{ 'nav.compare'|trans|capitalize }}" />
                        <twig:NavLink url="/settings" icon="lucide:settings" label="Settings" />
                    </ul>
                </div>
            </div>
        </div>
    </body>
</html>
