{% extends 'base.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block body %}
    <div class="hero bg-base-200 min-h-screen">
        <div class="hero-content text-center">
            <div class="max-w-md">
                <h1 class="text-5xl font-bold">{{ 'hello'|trans({}, 'main')|upper }}</h1>
                <p class="py-6"> {{ 'desc'|trans({}, 'main')|capitalize }} </p>
                <div>
                    <a class="btn btn-primary" href="{{ path('app_player_search') }}">
                        <twig:ux:icon name="lucide:chart-column" />
                        {{ 'player_analyse_btn'|trans({}, 'main')|capitalize }}
                    </a>
                </div>
                <div class="grid grid-cols-2 gap-4 mt-6">
                    <div>
                        <div class="inline-grid *:[grid-area:1/1]">
                            <div class="status status-error animate-ping"></div>
                            <div class="status status-error"></div>
                        </div> {{ 'analyse'|trans({}, 'main')|capitalize }}
                    </div>
                    <div>
                        <div class="inline-grid *:[grid-area:1/1]">
                            <div class="status status-info animate-ping"></div>
                            <div class="status status-info"></div>
                        </div> {{ 'interface'|trans({}, 'main')|capitalize }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
